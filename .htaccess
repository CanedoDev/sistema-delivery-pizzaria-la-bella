# ==============================================================================
# La Bella Pizza - Configuração Apache / LiteSpeed (Hostinger)
# Otimização de Performance, Ciclo de Vida de Cache e Segurança
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. URLs Amigáveis (Clean URLs) & Redirecionamentos 301
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 0.1 Redirecionar acessos antigos com acento (/cardápio ou /cardápio.html) para /cardapio limpo
    RewriteCond %{THE_REQUEST} /card(%C3%A1|%c3%a1|á)pio(\.html)? [NC]
    RewriteRule ^.*$ /cardapio [R=301,L]

    # 0.2 Redirecionar /index ou /index.html para a raiz /
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index(\.html)?[\s?] [NC]
    RewriteRule ^index(\.html)?$ / [R=301,L]

    # 0.3 Se o visitante ou bot acessar diretamente qualquer arquivo com .html, redireciona 301 para a versão sem extensão
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+([^.\s?]+)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # 0.4 Reescrita interna: entrega o arquivo .html existente quando requisitado sem extensão
    # Ex: /cardapio -> cardapio.html | /linkbio -> linkbio.html | /privacidade -> privacidade.html
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ $1.html [L,QSA]
</IfModule>

# 1. Habilitar Expiração de Cache (mod_expires)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Documentos HTML (sempre revalidar para refletir atualizações)
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/xhtml+xml "access plus 0 seconds"

    # Mídias e Imagens (Cache longo de 1 ano recomendado pelo Google PageSpeed)
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

    # Fontes Web (1 ano)
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

    # CSS e JavaScript (1 ano com cache-busting v=...)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Dados e Feeds
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType text/xml "access plus 0 seconds"
</IfModule>

# 2. Cabeçalhos HTTP de Cache-Control (mod_headers)
<IfModule mod_headers.c>
    # Imagens, Vetores e Fontes: 1 ano imutável
    <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|svg|woff2|woff|ttf|otf|eot)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    # Folhas de Estilo e Scripts JS: 1 ano público
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>

    # Páginas HTML: não cachear para que o visitante sempre veja o código atual
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Proteções de Segurança Recomendadas pelo Lighthouse
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 3. Compressão Gzip / Deflate (mod_deflate)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 4. Página de Erro 404 Personalizada (Sobrescreve a página padrão da Hostinger)
ErrorDocument 404 /404.html

